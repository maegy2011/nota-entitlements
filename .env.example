# Copy to .env and fill real values. Never commit .env.
PORT=3111
HOST=127.0.0.1
DATABASE_URL=postgresql://nota_svc:CHANGE_ME@localhost:5432/nota_entitlements
TEST_MODE=false
# Beta-only trial for exactly one account. Leave TRIAL_ACCOUNT_ID empty to disable.
TRIAL_ACCOUNT_ID=
TRIAL_FEATURES=folders,location,tags,reminders,pdf,lock,favorites,pin,widget,cloud,backgrounds,media,shred
TRIAL_EXPIRES_AT=

# Admin dashboard (optional). Leave empty to disable /admin + /v1/admin/*.
ADMIN_TOKEN=

# Google Play Developer API (optional; enables Play Console integration in admin dashboard)
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT=
# or inline JSON:
# PLAY_SERVICE_ACCOUNT_JSON=

# RTDN webhook shared secret (optional but recommended in production)
RTDN_SECRET=

# Optional: comma-separated authorized parties (OAuth client IDs) for azp validation.
# Leave empty for lenient mode (azp logged but not enforced).
FIREBASE_AUTHORIZED_PARTIES=
